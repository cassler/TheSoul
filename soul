function generateSeed() {
  const chars = "ABCDEFGHIJKLMNPQRSTUVWXYZ123456789"; // No O or 0
  const length = Math.floor(Math.random() * 5) + 4; // 4-8 chars
  let seed = "";
  for (let i = 0; i < length; i++) {
    seed += chars[Math.floor(Math.random() * chars.length)];
  }
  return seed;
}

function displayMatchTable(matchDetails) {
  if (matchDetails.length === 0) return;

  // Parse match details to extract structured data
  const rows = matchDetails.map((detail) => {
    // Parse different types: "Boss: X (Ante Y)", "Joker: X (Ante Y, Shop slot Z)", "Pack Card: X from Y (Ante Z)"
    const bossMatch = detail.match(/^Boss: (.+) \(Ante (\d+)\)$/);
    const voucherMatch = detail.match(/^Voucher: (.+) \(Ante (\d+)\)$/);
    const tagMatch = detail.match(/^Tag: (.+) \(Ante (\d+)\)$/);
    const jokerMatch = detail.match(
      /^Joker: (.+) \(Ante (\d+), Shop slot (\d+)\)$/
    );
    const itemMatch = detail.match(
      /^Item: (.+) \(Ante (\d+), Shop slot (\d+)\)$/
    );
    const packMatch = detail.match(
      /^Pack Card: (.+) from (.+) \(Ante (\d+)\)$/
    );

    if (bossMatch) {
      return {
        type: "Boss",
        name: bossMatch[1],
        ante: bossMatch[2],
        slot: "-",
      };
    } else if (voucherMatch) {
      return {
        type: "Voucher",
        name: voucherMatch[1],
        ante: voucherMatch[2],
        slot: "-",
      };
    } else if (tagMatch) {
      return { type: "Tag", name: tagMatch[1], ante: tagMatch[2], slot: "-" };
    } else if (jokerMatch) {
      return {
        type: "Joker",
        name: jokerMatch[1],
        ante: jokerMatch[2],
        slot: jokerMatch[3],
      };
    } else if (itemMatch) {
      return {
        type: "Item",
        name: itemMatch[1],
        ante: itemMatch[2],
        slot: itemMatch[3],
      };
    } else if (packMatch) {
      return {
        type: "Pack",
        name: `${packMatch[1]} (${packMatch[2]})`,
        ante: packMatch[3],
        slot: "-",
      };
    } else {
      return { type: "Other", name: detail, ante: "-", slot: "-" };
    }
  });

  // Calculate column widths
  const typeWidth = Math.max(4, ...rows.map((r) => r.type.length));
  const nameWidth = Math.max(4, ...rows.map((r) => r.name.length));
  const anteWidth = 4;
  const slotWidth = 4;

  // Create table header
  const separator = `├${"─".repeat(typeWidth + 2)}┼${"─".repeat(
    nameWidth + 2
  )}┼${"─".repeat(anteWidth + 2)}┼${"─".repeat(slotWidth + 2)}┤`;
  const topBorder = `┌${"─".repeat(typeWidth + 2)}┬${"─".repeat(
    nameWidth + 2
  )}┬${"─".repeat(anteWidth + 2)}┬${"─".repeat(slotWidth + 2)}┐`;
  const bottomBorder = `└${"─".repeat(typeWidth + 2)}┴${"─".repeat(
    nameWidth + 2
  )}┴${"─".repeat(anteWidth + 2)}┴${"─".repeat(slotWidth + 2)}┘`;

  console.log(topBorder);
  console.log(
    `│ ${"Type".padEnd(typeWidth)} │ ${"Name".padEnd(
      nameWidth
    )} │ ${"Ante".padEnd(anteWidth)} │ ${"Slot".padEnd(slotWidth)} │`
  );
  console.log(separator);

  rows.forEach((row) => {
    console.log(
      `│ ${row.type.padEnd(typeWidth)} │ ${row.name.padEnd(
        nameWidth
      )} │ ${row.ante.padEnd(anteWidth)} │ ${row.slot.padEnd(slotWidth)} │`
    );
  });

  console.log(bottomBorder);
}

function analyzeSeed(seed, options = {}) {
  const {
    ante = 8,
    deck = "Red Deck",
    stake = "White Stake",
    compact = false,
    shopLimit = [20, 40, 60, 75, 75, 75, 75, 75],
  } = options;

  try {
    const inst = new Immolate.Instance(seed);
    inst.params = new Immolate.InstParams(deck, stake, false, 10106);
    inst.initLocks(1, false, false);

    // Lock standard vouchers
    const lockedVouchers = [
      "Overstock Plus",
      "Liquidation",
      "Glow Up",
      "Reroll Glut",
      "Omen Globe",
      "Observatory",
      "Nacho Tong",
      "Recyclomancy",
      "Tarot Tycoon",
      "Planet Tycoon",
      "Money Tree",
      "Antimatter",
      "Illusion",
      "Petroglyph",
      "Retcon",
      "Palette",
    ];
    lockedVouchers.forEach((v) => inst.lock(v));

    inst.setStake(stake);
    inst.setDeck(deck);

    let results = {
      seed: seed,
      deck: deck,
      stake: stake,
      antes: [],
    };

    for (let a = 1; a <= ante; a++) {
      inst.initUnlocks(a, false);

      let anteData = { ante: a };

      // Boss
      anteData.boss = inst.nextBoss(a);

      // Voucher
      const voucher = inst.nextVoucher(a);
      anteData.voucher = voucher;
      inst.lock(voucher);

      // Unlock next level voucher
      for (let i = 0; i < Immolate.VOUCHERS.size(); i += 2) {
        if (
          Immolate.VOUCHERS.get(i) === voucher &&
          i + 1 < Immolate.VOUCHERS.size()
        ) {
          inst.unlock(Immolate.VOUCHERS.get(i + 1));
          break;
        }
      }

      // Tags
      anteData.tag1 = inst.nextTag(a);
      anteData.tag2 = inst.nextTag(a);

      // Check if tags will add specific jokers to next shop
      if (a < ante) {  // Only check if there's a next ante
        if (anteData.tag1 === "Uncommon Tag") {
          const uncommonJoker = inst.nextJoker("unc", a + 1, false);
          anteData.tag1 += ` (adds ${uncommonJoker.joker})`;
          uncommonJoker.delete();
        } else if (anteData.tag1 === "Rare Tag") {
          const rareJoker = inst.nextJoker("rar", a + 1, false);
          anteData.tag1 += ` (adds ${rareJoker.joker})`;
          rareJoker.delete();
        }

        if (anteData.tag2 === "Uncommon Tag") {
          const uncommonJoker = inst.nextJoker("unc", a + 1, false);
          anteData.tag2 += ` (adds ${uncommonJoker.joker})`;
          uncommonJoker.delete();
        } else if (anteData.tag2 === "Rare Tag") {
          const rareJoker = inst.nextJoker("rar", a + 1, false);
          anteData.tag2 += ` (adds ${rareJoker.joker})`;
          rareJoker.delete();
        }
      }

      // Shop items (first few for search purposes)
      if (!compact) {
        anteData.shop = [];
        const shopItemLimit = options.shopLimit ? (options.shopLimit[a - 1] || options.shopLimit[options.shopLimit.length - 1] || 80) : (shopLimit[a - 1] || shopLimit[shopLimit.length - 1] || 80);
        for (let i = 1; i <= shopItemLimit; i++) {
          try {
            const item = inst.nextShopItem(a);
            // Handle undefined item names
            const itemName = item.item || "Unknown Item";
            let itemInfo = { name: itemName, type: item.type };

            if (item.type === "Joker") {
              itemInfo.eternal = item.jokerData.stickers.eternal;
              itemInfo.perishable = item.jokerData.stickers.perishable;
              itemInfo.rental = item.jokerData.stickers.rental;
              itemInfo.edition = item.jokerData.edition;
            } else {
              // Non-joker items don't have editions/stickers
              itemInfo.eternal = false;
              itemInfo.perishable = false;
              itemInfo.rental = false;
              itemInfo.edition = "No Edition";
            }

            anteData.shop.push(itemInfo);
            item.delete();
          } catch (error) {
            // If we hit memory issues, stop generating more items for this ante
            console.warn(
              `Memory error at shop item ${i} for seed ${seed}, ante ${a}: ${error.message}`
            );
            break;
          }
        }
      }

      // Packs analysis
      if (!compact) {
        anteData.packs = [];
        const numPacks = a == 1 ? 4 : 6;

        for (let p = 1; p <= numPacks; p++) {
          try {
            const packName = inst.nextPack(a);
            const packInfo = Immolate.packInfo(packName);
            let packData = { name: packName, cards: [] };

            if (packInfo.type === "Celestial Pack") {
              const cards = inst.nextCelestialPack(packInfo.size, a);
              for (let c = 0; c < cards.size(); c++) {
                packData.cards.push(cards.get(c));
              }
              cards.delete();
            } else if (packInfo.type === "Arcana Pack") {
              const cards = inst.nextArcanaPack(packInfo.size, a);
              for (let c = 0; c < cards.size(); c++) {
                const cardName = cards.get(c);
                if (cardName === "The Soul") {
                  // The Soul creates a legendary joker - determine which one
                  const legendaryJoker = inst.nextJoker("sou", a, true);

                  // Build full joker description including edition and stickers
                  let jokerDesc = legendaryJoker.joker;
                  if (legendaryJoker.edition !== "No Edition")
                    jokerDesc = `${legendaryJoker.edition} ${jokerDesc}`;
                  if (legendaryJoker.stickers.eternal)
                    jokerDesc = `Eternal ${jokerDesc}`;
                  if (legendaryJoker.stickers.perishable)
                    jokerDesc = `Perishable ${jokerDesc}`;
                  if (legendaryJoker.stickers.rental)
                    jokerDesc = `Rental ${jokerDesc}`;

                  packData.cards.push(`${cardName} (creates ${jokerDesc})`);
                  legendaryJoker.delete();
                } else {
                  packData.cards.push(cardName);
                }
              }
              cards.delete();
            } else if (packInfo.type === "Spectral Pack") {
              const cards = inst.nextSpectralPack(packInfo.size, a);
              for (let c = 0; c < cards.size(); c++) {
                packData.cards.push(cards.get(c));
              }
              cards.delete();
            } else if (packInfo.type === "Buffoon Pack") {
              const jokers = inst.nextBuffoonPack(
                packInfo.size,
                packInfo.choices,
                a
              );
              for (let c = 0; c < jokers.size(); c++) {
                const joker = jokers.get(c);
                packData.cards.push(joker.joker);
                joker.delete();
              }
              jokers.delete();
            } else if (packInfo.type === "Standard Pack") {
              const cards = inst.nextStandardPack(
                packInfo.size,
                packInfo.choices,
                a,
                false
              );
              for (let c = 0; c < packInfo.choices && c < cards.size(); c++) {
                const card = cards.get(c);

                // Convert card code to readable name
                function formatCard(cardCode) {
                  const [suit, rank] = cardCode.split("_");
                  const suitNames = {
                    C: "Clubs",
                    D: "Diamonds",
                    H: "Hearts",
                    S: "Spades",
                  };
                  const rankNames = {
                    A: "Ace",
                    J: "Jack",
                    Q: "Queen",
                    K: "King",
                  };
                  const suitName = suitNames[suit] || suit;
                  const rankName = rankNames[rank] || rank;
                  return `${rankName} of ${suitName}`;
                }

                let cardDesc = formatCard(card.base);
                if (card.seal !== "No Seal")
                  cardDesc = `${card.seal} ${cardDesc}`;
                if (card.enhancement !== "No Enhancement")
                  cardDesc = `${card.enhancement} ${cardDesc}`;
                if (card.edition !== "No Edition")
                  cardDesc = `${card.edition} ${cardDesc}`;
                packData.cards.push(cardDesc);
              }
              cards.delete();
            }

            packInfo.delete();
            anteData.packs.push(packData);
          } catch (error) {
            console.warn(
              `Memory error at pack ${p} for seed ${seed}, ante ${a}: ${error.message}`
            );
            break;
          }
        }
      }

      results.antes.push(anteData);
    }

    inst.delete();
    return results;
  } catch (error) {
    console.error(`Error analyzing seed ${seed}:`, error.message);
    return null;
  }
}

async function searchForItem(searchOptions) {
  const {
    find = [],
    joker = [],
    voucher = [],
    boss = [],
    tag = [],
    max = 5000,
    early = null,
    quiet = false,
    deck = "Ghost Deck",
    stake = "White Stake",
    matchAll = true, // false = ANY (OR), true = ALL (AND)
    saveFile = null,
    progressInterval = 1000,
    stopOnFirst = false,
  } = searchOptions;

  // Flatten arrays and filter out empty strings
  const allTerms = [...find, ...joker, ...voucher, ...boss, ...tag].filter(
    Boolean
  );
  if (allTerms.length === 0) {
    console.error("Error: Must specify at least one search term");
    return;
  }

  if (!quiet) {
    const termsByType = [];
    if (find.length) termsByType.push(`General: ${find.join(", ")}`);
    if (joker.length) termsByType.push(`Jokers: ${joker.join(", ")}`);
    if (voucher.length) termsByType.push(`Vouchers: ${voucher.join(", ")}`);
    if (boss.length) termsByType.push(`Bosses: ${boss.join(", ")}`);
    if (tag.length) termsByType.push(`Tags: ${tag.join(", ")}`);

    console.log(`Searching for: ${termsByType.join(" | ")}`);
    console.log(`Match logic: ${matchAll ? "ALL (AND)" : "ANY (OR)"}`);
    console.log(`Max seeds: ${max === Infinity ? "UNLIMITED" : max}`);
    console.log(`Deck: ${deck}, Stake: ${stake}`);
    if (early) console.log(`Early exit: Ante ${early}`);
    if (saveFile) console.log(`Saving matches to: ${saveFile}`);
    console.log("");
  }

  let seedsChecked = 0;
  let matches = [];
  const startTime = Date.now();

  // Helper function to save matches to file
  function saveMatches() {
    if (saveFile && matches.length > 0) {
      const fs = require("fs");
      const content =
        matches
          .map((match) => `${match.seed}: ${match.details.join(", ")}`)
          .join("\n") + "\n";
      fs.writeFileSync(saveFile, content);
    }
  }

  // Handle Ctrl+C gracefully
  let isExiting = false;
  function handleExit() {
    if (isExiting) return;
    isExiting = true;

    console.log("\n\n🛑 Search interrupted by user");
    if (saveFile) {
      console.log("Saving matches before exit...");
      saveMatches();
    }
    console.log(`\nSearch stopped! Checked ${seedsChecked} seeds.`);
    console.log(`Found ${matches.length} matching seeds.`);
    process.exit(0);
  }

  process.on("SIGINT", handleExit);
  process.on("SIGTERM", handleExit);

  // Memory management - force GC every N seeds
  const GC_INTERVAL = 1000;

  // Search in batches to prevent memory buildup
  const BATCH_SIZE = 1000;

  async function searchBatch(batchMax) {
    const batchStart = seedsChecked;
    while (seedsChecked < batchMax && seedsChecked < max && !isExiting) {
      const seed = generateSeed();
      seedsChecked++;

      if (
        !quiet &&
        seedsChecked % (max === Infinity ? progressInterval : 10) === 0
      ) {
        const maxDisplay = max === Infinity ? "∞" : max;
        const rate =
          seedsChecked > 0
            ? Math.round((seedsChecked / (Date.now() - startTime)) * 1000)
            : 0;
        process.stdout.write(
          `\rChecked ${seedsChecked}/${maxDisplay} seeds (${rate}/sec, ${matches.length} matches)...`
        );
      }

      // Memory management - force garbage collection periodically
      if (seedsChecked % GC_INTERVAL === 0) {
        if (global.gc) {
          global.gc();
        }
        // Allow event loop to process (enables Ctrl+C)
        await new Promise((resolve) => setImmediate(resolve));
      }

      let results;
      try {
        results = analyzeSeed(seed, {
          ante: early || 8,
          deck: deck,
          stake: stake,
          compact: false, // Need shop data for search
        });
      } catch (error) {
        if (
          error.message &&
          error.message.includes("memory access out of bounds")
        ) {
          // Skip this problematic seed and continue
          continue;
        } else {
          // Re-throw other errors
          throw error;
        }
      }

      if (!results) continue;

      // Check for matches - collect all matches first
      let foundMatches = new Set(); // Track which criteria we've matched
      let matchDetails = [];

      for (const anteData of results.antes) {
        // Check bosses
        for (const bossSearch of boss) {
          if (anteData.boss.toLowerCase().includes(bossSearch.toLowerCase())) {
            foundMatches.add(`boss:${bossSearch}`);
            matchDetails.push(`Boss: ${anteData.boss} (Ante ${anteData.ante})`);
          }
        }

        // Check vouchers
        for (const voucherSearch of voucher) {
          if (
            anteData.voucher.toLowerCase().includes(voucherSearch.toLowerCase())
          ) {
            foundMatches.add(`voucher:${voucherSearch}`);
            matchDetails.push(
              `Voucher: ${anteData.voucher} (Ante ${anteData.ante})`
            );
          }
        }

        // Check tags
        for (const tagSearch of tag) {
          if (anteData.tag1.toLowerCase().includes(tagSearch.toLowerCase())) {
            foundMatches.add(`tag:${tagSearch}`);
            matchDetails.push(`Tag: ${anteData.tag1} (Ante ${anteData.ante})`);
          }
          if (anteData.tag2.toLowerCase().includes(tagSearch.toLowerCase())) {
            foundMatches.add(`tag:${tagSearch}`);
            matchDetails.push(`Tag: ${anteData.tag2} (Ante ${anteData.ante})`);
          }
        }

        // Check shop items
        if (anteData.shop) {
          for (const item of anteData.shop) {
            // Check jokers
            for (const jokerSearch of joker) {
              if (item.type === "Joker") {
                // Build full joker description first
                let itemDesc = item.name;
                if (item.edition !== "No Edition")
                  itemDesc = `${item.edition} ${itemDesc}`;
                if (item.eternal) itemDesc = `Eternal ${itemDesc}`;
                if (item.perishable) itemDesc = `Perishable ${itemDesc}`;
                if (item.rental) itemDesc = `Rental ${itemDesc}`;

                // Search against the full description
                if (
                  itemDesc.toLowerCase().includes(jokerSearch.toLowerCase())
                ) {
                  foundMatches.add(`joker:${jokerSearch}`);
                  const shopIndex = anteData.shop.indexOf(item) + 1;
                  matchDetails.push(
                    `Joker: ${itemDesc} (Ante ${anteData.ante}, Shop slot ${shopIndex})`
                  );
                }
              }
            }

            // Check general find
            for (const findSearch of find) {
              if (item.name.toLowerCase().includes(findSearch.toLowerCase())) {
                foundMatches.add(`find:${findSearch}`);
                const shopIndex = anteData.shop.indexOf(item) + 1;
                matchDetails.push(
                  `Item: ${item.name} (Ante ${anteData.ante}, Shop slot ${shopIndex})`
                );
              }
            }
          }
        }

        // Check pack items
        if (anteData.packs) {
          for (const pack of anteData.packs) {
            for (const card of pack.cards) {
              // Skip undefined/null cards
              if (!card || typeof card !== "string") continue;

              // Check general find in pack cards
              for (const findSearch of find) {
                if (card.toLowerCase().includes(findSearch.toLowerCase())) {
                  foundMatches.add(`find:${findSearch}`);
                  matchDetails.push(
                    `Pack Card: ${card} from ${pack.name} (Ante ${anteData.ante})`
                  );
                }
              }
            }
          }
        }
      }

      // Determine if this seed matches our criteria
      const totalCriteria =
        find.length + joker.length + voucher.length + boss.length + tag.length;
      const matchedCriteria = foundMatches.size;

      let matched = false;
      if (matchAll) {
        // AND logic - need to match ALL criteria
        matched = matchedCriteria === totalCriteria;
      } else {
        // OR logic - need to match ANY criteria
        matched = matchedCriteria > 0;
      }

      if (matched) {
        matches.push({ seed, details: matchDetails });
        if (!quiet) {
          process.stdout.write("\r" + " ".repeat(50) + "\r"); // Clear progress line
        }
        console.log(`\n🎯 MATCH FOUND: ${seed}`);
        displayMatchTable(matchDetails);
        console.log("");

        // Save matches immediately when found
        if (saveFile) {
          saveMatches();
        }

        // Stop on first match if requested
        if (stopOnFirst) {
          console.log("🛑 Stopping search after first match (--first flag)");
          return; // Return from batch function to stop entire search
        }
      }
    }
  }

  // Run search in batches with cleanup between
  while (seedsChecked < max && !isExiting) {
    const nextBatch = Math.min(seedsChecked + BATCH_SIZE, max);

    await searchBatch(nextBatch);

    // Check if we should stop after first match
    if (stopOnFirst && matches.length > 0) {
      break;
    }

    // Cleanup between batches
    if (global.gc) {
      global.gc();
    }

    // Small pause between batches to let memory settle
    if (seedsChecked < max && !isExiting) {
      await new Promise((resolve) => setTimeout(resolve, 10));
    }
  }

  if (!quiet) {
    process.stdout.write("\r" + " ".repeat(50) + "\r"); // Clear progress line
  }

  // Final save
  if (saveFile) {
    saveMatches();
    console.log(`Matches saved to ${saveFile}`);
  }

  console.log(`\nSearch complete! Checked ${seedsChecked} seeds.`);
  console.log(`Found ${matches.length} matching seeds.`);

  if (matches.length > 0 && !saveFile) {
    console.log("\nAll matches:");
    matches.forEach((match) => {
      console.log(`${match.seed}: ${match.details.join(", ")}`);
    });
  }
}

// Parse arguments
const args = process.argv.slice(2);

if (args.length === 0 || args.includes("--help") || args.includes("-h")) {
  printHelp();
  process.exit(0);
}

// Wait for WebAssembly to load
setTimeout(async () => {
  if (!global.Immolate.Instance) {
    console.error("Error: WebAssembly module failed to load");
    process.exit(1);
  }

  try {
    if (args.includes("--search")) {
      // Search mode
      const searchOptions = {
        find: [],
        joker: [],
        voucher: [],
        boss: [],
        tag: [],
        matchAll: false,
      };

      for (let i = 0; i < args.length; i++) {
        const arg = args[i];
        switch (arg) {
          case "--find":
            searchOptions.find.push(args[++i]);
            break;
          case "--joker":
            searchOptions.joker.push(args[++i]);
            break;
          case "--voucher":
            searchOptions.voucher.push(args[++i]);
            break;
          case "--boss":
            searchOptions.boss.push(args[++i]);
            break;
          case "--tag":
            searchOptions.tag.push(args[++i]);
            break;
          case "--max":
            searchOptions.max = parseInt(args[++i]);
            break;
          case "--early":
            searchOptions.early = parseInt(args[++i]);
            break;
          case "--deck":
          case "-d":
            searchOptions.deck = args[++i] + " Deck";
            break;
          case "--stake":
          case "-s":
            searchOptions.stake = args[++i] + " Stake";
            break;
          case "--quiet":
          case "-q":
            searchOptions.quiet = true;
            break;
          case "--all":
            searchOptions.matchAll = true;
            break;
          case "--unlimited":
            searchOptions.max = Infinity;
            break;
          case "--save":
            searchOptions.saveFile = args[++i];
            break;
          case "--progress":
            searchOptions.progressInterval = parseInt(args[++i]) || 1000;
            break;
          case "--first":
          case "--stop":
            searchOptions.stopOnFirst = true;
            break;
          case "--any":
            searchOptions.matchAll = false;
            break;
        }
      }

      await searchForItem(searchOptions);
    } else {
      // Single seed analysis
      const seed = args[0].toUpperCase().replace(/0/g, "O");
      const options = {};

      for (let i = 1; i < args.length; i++) {
        const arg = args[i];
        switch (arg) {
          case "--ante":
          case "-a":
            options.ante = parseInt(args[++i]);
            break;
          case "--deck":
          case "-d":
            options.deck = args[++i] + " Deck";
            break;
          case "--stake":
          case "-s":
            options.stake = args[++i] + " Stake";
            break;
          case "--compact":
            options.compact = true;
            break;
          case "--shop-limit":
            try {
              options.shopLimit = JSON.parse(args[++i]);
            } catch (e) {
              console.error("Error: --shop-limit must be a valid JSON array like [20,40,60,75]");
              process.exit(1);
            }
            break;
        }
      }

      const results = analyzeSeed(seed, options);
      if (results) {
        // console.log(JSON.stringify(results, null, 2));
        console.log(`\nSeed: ${results.seed}`);
        console.log(`Deck: ${results.deck}, Stake: ${results.stake}`);
        console.log("=".repeat(50));

        results.antes.forEach((ante) => {
          console.log(`\nAnte ${ante.ante}:`);
          console.log(`  Boss: ${ante.boss}`);
          console.log(`  Voucher: ${ante.voucher}`);
          console.log(`  Tags: ${ante.tag1}, ${ante.tag2}`);

          if (ante.shop && !options.compact) {
            console.log(`  Shop (first ${ante.shop.length}):`);
            ante.shop.forEach((item, i) => {
              let desc = item.name;
              if (item.edition !== "No Edition")
                desc = `${item.edition} ${desc}`;
              if (item.eternal) desc = `Eternal ${desc}`;
              if (item.perishable) desc = `Perishable ${desc}`;
              if (item.rental) desc = `Rental ${desc}`;
              console.log(`    ${i + 1}) ${desc}`);
            });
          }

          if (ante.packs && !options.compact) {
            console.log(`  Packs:`);
            ante.packs.forEach((pack, i) => {
              console.log(
                `    ${i + 1}) ${pack.name} - ${pack.cards.join(", ")}`
              );
            });
          }
        });
      }
    }
  } catch (error) {
    console.error("Error:", error.message);
    process.exit(1);
  }
}, 100); // Small delay for WASM to load
